{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "area": {
      "type": "string",
      "title": "\u00c1rea de la vida",
      "enum": [
        "subsistencia",
        "vivienda",
        "trabajo",
        "cuidados",
        "educacion",
        "salud",
        "ocio",
        "comunidad"
      ],
      "default": "subsistencia"
    },
    "location": {
      "type": "string",
      "title": "Ubicaci\u00f3n (texto)"
    },
    "neighborhood": {
      "type": "string",
      "title": "Barrio"
    },
    "address": {
      "type": "string",
      "title": "Direcci\u00f3n exacta"
    },
    "lat": {
      "type": "number",
      "title": "Latitud"
    },
    "lng": {
      "type": "number",
      "title": "Longitud"
    },
    "contribution_type": {
      "type": "string",
      "title": "Tipo de aporte",
      "enum": [
        "dinero",
        "tiempo",
        "espacio",
        "conocimiento"
      ],
      "default": "tiempo"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "idea",
        "buscando",
        "activandose",
        "funcionando",
        "necesita_piezas"
      ],
      "default": "idea"
    },
    "people_needed": {
      "type": "number",
      "title": "Personas necesarias",
      "default": 5
    },
    "people_joined": {
      "type": "number",
      "title": "Personas unidas",
      "default": 0
    },
    "image_url": {
      "type": "string",
      "title": "Foto",
      "format": "uri"
    },
    "conditions": {
      "type": "string",
      "title": "Condiciones para activarse"
    },
    "what_happens": {
      "type": "string",
      "title": "Qu\u00e9 pasar\u00e1 si se activa"
    },
    "what_needed": {
      "type": "string",
      "title": "Qu\u00e9 hace falta para existir"
    },
    "template_name": {
      "type": "string",
      "title": "Plantilla de origen"
    }
  },
  "required": [
    "title",
    "area",
    "contribution_type",
    "status",
    "neighborhood"
  ]
}